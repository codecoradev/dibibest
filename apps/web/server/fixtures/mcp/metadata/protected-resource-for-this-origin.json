{
  "title": "points at the identity provider for this origin (RFC 9728), open CORS",
  "steps": [
    {
      "token": null,
      "request": {"method": "GET", "path": "/.well-known/oauth-protected-resource/mcp"},
      "expect": {
        "status": 200,
        "headers": {"access-control-allow-origin": "*", "content-type": {"contains": "application/json"}},
        "body": [
          {"path": ["resource"], "equals": "$resource"},
          {"path": ["authorization_servers"], "equals": ["$issuer"]}
        ]
      }
    }
  ]
}
