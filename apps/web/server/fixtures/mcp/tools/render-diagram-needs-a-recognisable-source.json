{
  "title": "a source that is no schema is a tool error",
  "steps": [
    {
      "request": {
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {"name": "render_diagram", "arguments": {"source": "hello"}}
        }
      },
      "expect": {"status": 200, "body": [{"path": ["result", "isError"], "equals": true}]}
    }
  ]
}
